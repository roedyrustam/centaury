{
  "name": "centaury-monorepo",
  "version": "1.0.0-alpha",
  "private": true,
  "description": "The Autonomous Fullstack Engine for Super-Intelligent Systems (Gemini 4 Pro, Project Astra, Dual-Citizen MCP v1.x, Zero-Hydration Signals, Ephemeral UI)",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run --cwd examples/showcase-app dev",
