    "test": "bun test",
    "bench": "bun run scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "release:check": "bun run scripts/e2e-release-test.ts"
  },
  "keywords": [
    "centaury",
    "bun",
    "bun-framework",
    "fullstack",
    "ai-framework",
    "agentic-ai",
    "gemini",
    "gemini-4-pro",
    "project-astra",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "zero-hydration",
    "signals",
    "micro-signals",
    "ephemeral-ui",
    "generative-ui",
    "high-performance",
    "trie-router",
    "rpc",
    "websockets",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/centaury.git"
  },
  "homepage": "https://github.com/roedyrustam/centaury#readme",
  "bugs": {
    "url": "https://github.com/roedyrustam/centaury/issues"
  },
